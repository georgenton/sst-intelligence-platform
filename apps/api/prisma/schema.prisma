  acknowledgementStatus PpeAcknowledgementStatus @default(PENDING)
  acknowledgedAt        DateTime?
  acknowledgedById      String?                  @db.Uuid
  acknowledgementNote   String?                  @db.VarChar(2000)
  evidenceNote          String?                  @db.VarChar(2000)
  evidenceUrl           String?                  @db.VarChar(2000)
  replacesIssueId       String?                  @unique @db.Uuid
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  worker                Worker                   @relation(fields: [workerId], references: [id], onDelete: Restrict)
  ppeCatalogItem        PpeCatalogItem           @relation(fields: [ppeCatalogItemId], references: [id], onDelete: Restrict)
