  incident       Incident               @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  recordedBy     User                   @relation("IncidentFactorRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([organizationId, incidentId, recordedAt])
}

model IncidentAction {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  incidentId       String               @db.Uuid
  title            String               @db.VarChar(200)
  description      String?              @db.VarChar(2000)
  status           IncidentActionStatus @default(OPEN)
  priority         ActionPriority       @default(MEDIUM)
  ownerUserId      String?              @db.Uuid
  dueAt            DateTime?
  createdById      String               @db.Uuid
  verifiedById     String?              @db.Uuid
  verifiedAt       DateTime?
  verificationNote String?              @db.VarChar(2000)
  version          Int                  @default(1)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident         Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  owner            User?                @relation("IncidentActionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy        User                 @relation("IncidentActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy       User?                @relation("IncidentActionVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
