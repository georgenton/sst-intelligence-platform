model User {
  id                           String                                        @id @default(uuid()) @db.Uuid
  email                        String                                        @unique
  passwordHash                 String
  displayName                  String
  createdAt                    DateTime                                      @default(now())
  updatedAt                    DateTime                                      @updatedAt
  refreshSessions              RefreshSession[]
  memberships                  Membership[]
  claimedGuidedSessions        GuidedFlowSession[]                           @relation("ClaimedBy")
  auditLogs                    AuditLog[]                                    @relation("AuditActor")
  aiInteractions               AiInteraction[]
  upgradeRequests              UpgradeRequest[]
  inspections                  Inspection[]                                  @relation("InspectionInspector")
  findingsCreated              InspectionFinding[]                           @relation("FindingCreator")
  actionsAssigned              CorrectiveAction[]                            @relation("ActionAssignee")
  actionsCreated               CorrectiveAction[]                            @relation("ActionCreator")
  actionsVerified              CorrectiveAction[]                            @relation("ActionVerifier")
  evidenceCreated              ActionEvidence[]                              @relation("EvidenceCreator")
  alertsAcknowledged           InspectionAlert[]                             @relation("AlertAcknowledger")
  systemicReviewsCreated       InspectionSystemicReview[]                    @relation("SystemicReviewCreator")
  systemicReviewsCompleted     InspectionSystemicReview[]                    @relation("SystemicReviewCompleter")
  technicalAssessments         TechnicalAssessment[]                         @relation("TechnicalAssessmentCreator")
  technicalAssessmentsReviewed TechnicalAssessment[]                         @relation("TechnicalAssessmentReviewer")
  technicalEvidenceCreated     TechnicalAssessmentEvidence[]                 @relation("TechnicalEvidenceCreator")
  technicalReviews             TechnicalAssessmentReview[]                   @relation("TechnicalReviewReviewer")
  sstProfileVersions           OrganizationSstProfileVersion[]
  applicabilityAssessments     ApplicabilityAssessment[]
  adaptiveSessions             AdaptiveConfigurationSession[]                @relation("AdaptiveSessionCreator")
  adaptiveAnswers              AdaptiveFactAnswer[]                          @relation("AdaptiveAnswerAuthor")
  adaptiveDeclarations         AdaptiveCurrentStateDeclaration[]             @relation("AdaptiveDeclarationAuthor")
  adaptiveEvidence             AdaptiveCurrentStateEvidence[]                @relation("AdaptiveEvidenceAuthor")
  regulatoryReviews            RegulatoryInterpretationReview[]
  regulatoryEvaluationsCreated UnifiedSstEvaluation[]                        @relation("UnifiedEvaluationCreator")
  riskMethodPoliciesCreated    OrganizationRiskMethodPolicyVersion[]
  guidedProfilesCreated        OrganizationGuided5x5ProfileVersion[]
  obligationsAssigned          ObligationExecution[]                         @relation("ObligationAssignee")
  obligationsCreated           ObligationExecution[]                         @relation("ObligationCreator")
  obligationsCompleted         ObligationExecution[]                         @relation("ObligationCompleter")
  obligationsReviewed          ObligationExecution[]                         @relation("ObligationReviewer")
  obligationEvidenceCreated    ObligationExecutionEvidence[]                 @relation("ObligationEvidenceCreator")
  workPermitsRequested         WorkPermit[]                                  @relation("WorkPermitRequester")
  workPermitsApproved          WorkPermit[]                                  @relation("WorkPermitApprover")
  workPermitsClosed            WorkPermit[]                                  @relation("WorkPermitCloser")
  invitationsSent              OrganizationInvitation[]                      @relation("OrganizationInvitationSender")
  invitationsAccepted          OrganizationInvitation[]                      @relation("OrganizationInvitationAcceptor")
  inspectionStandardPolicies   OrganizationInspectionStandardPolicyVersion[]
  inspectionCriterionResults   InspectionCriterionResult[]
  workersCreated               Worker[]                                      @relation("WorkerCreator")
  workerProfiles               Worker[]                                      @relation("WorkerLinkedUser")
  incidentsReported            Incident[]                                    @relation("IncidentReporter")
  investigationsStarted        IncidentInvestigation[]                       @relation("IncidentInvestigationStarter")
  investigationsCompleted      IncidentInvestigation[]                       @relation("IncidentInvestigationCompleter")
  incidentFactorsRecorded      IncidentContributingFactor[]                  @relation("IncidentFactorRecorder")
  incidentActionsOwned         IncidentAction[]                              @relation("IncidentActionOwner")
  incidentActionsCreated       IncidentAction[]                              @relation("IncidentActionCreator")
  incidentActionsVerified      IncidentAction[]                              @relation("IncidentActionVerifier")
  incidentEvidenceCreated      IncidentEvidence[]                            @relation("IncidentEvidenceCreator")
  ppeCatalogItemsCreated       PpeCatalogItem[]                               @relation("PpeCatalogItemCreator")
  ppeRequirementsAssigned      WorkerPpeRequirement[]                         @relation("PpeRequirementAssigner")
  ppeIssuesIssued              PpeIssue[]                                     @relation("PpeIssueIssuer")
  ppeAcknowledgementsRecorded  PpeIssue[]                                     @relation("PpeAcknowledgementRecorder")
  ppeInspectionsRecorded       PpeInspection[]                                @relation("PpeInspectionRecorder")
}

model RefreshSession {
  id              String    @id @default(uuid()) @db.Uuid
  familyId        String    @db.Uuid
  tokenHash       String
  userId          String    @db.Uuid
  expiresAt       DateTime
  revokedAt       DateTime?
  reuseDetectedAt DateTime?
  replacedById    String?   @db.Uuid
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
}

model Organization {
  id                         String                                        @id @default(uuid()) @db.Uuid
  name                       String
  country                    String
  sector                     String?
  status                     OrganizationStatus                            @default(ACTIVE)
  demoStartedAt              DateTime?
  demoExpiresAt              DateTime?
  createdAt                  DateTime                                      @default(now())
  updatedAt                  DateTime                                      @updatedAt
  workCenters                WorkCenter[]
  memberships                Membership[]
  invitations                OrganizationInvitation[]
  modules                    OrganizationModule[]
  subscriptions              Subscription[]
  usageCounters              UsageCounter[]
  guidedSessions             GuidedFlowSession[]
  upgradeRequests            UpgradeRequest[]
  auditLogs                  AuditLog[]
  aiInteractions             AiInteraction[]
  workAreas                  WorkArea[]
  inspections                Inspection[]
  findings                   InspectionFinding[]
  correctiveActions          CorrectiveAction[]
  actionEvidence             ActionEvidence[]
  inspectionAlerts           InspectionAlert[]
  inspectionSystemicReviews  InspectionSystemicReview[]
  technicalMethodDefinitions TechnicalMethodDefinition[]
  technicalMethodVersions    TechnicalMethodVersion[]
  technicalAssessments       TechnicalAssessment[]
  technicalResponses         TechnicalAssessmentResponse[]
  technicalResults           TechnicalAssessmentResult[]
  technicalEvidence          TechnicalAssessmentEvidence[]
  technicalReviews           TechnicalAssessmentReview[]
  technicalRiskValuations    TechnicalAssessmentRiskValuation[]
  sstProfileVersions         OrganizationSstProfileVersion[]
  applicabilityAssessments   ApplicabilityAssessment[]
  applicabilityDecisions     ApplicabilityDecision[]
  applicabilityTraces        ApplicabilityEvaluationTrace[]
  adaptiveSessions           AdaptiveConfigurationSession[]
  adaptiveScopes             AdaptiveSessionScope[]
  adaptiveAnswers            AdaptiveFactAnswer[]
  adaptiveRuns               AdaptiveEvaluationRun[]
  adaptiveQuestions          AdaptiveGeneratedQuestion[]
  adaptiveProposals          AdaptiveConfigurationProposal[]
  adaptiveItems              AdaptiveConfigurationItem[]
  adaptiveDeclarations       AdaptiveCurrentStateDeclaration[]
  adaptiveEvidence           AdaptiveCurrentStateEvidence[]
  unifiedSstEvaluations      UnifiedSstEvaluation[]
  riskMethodPolicies         OrganizationRiskMethodPolicyVersion[]
  guided5x5Profiles          OrganizationGuided5x5ProfileVersion[]
  findingRegulatoryLinks     InspectionFindingRegulatoryLink[]
  technicalRegulatoryLinks   TechnicalAssessmentRegulatoryLink[]
  obligationExecutions       ObligationExecution[]
  obligationEvidence         ObligationExecutionEvidence[]
  workPermits                WorkPermit[]
  inspectionStandardSources  InspectionStandardSource[]
  inspectionStandardPolicies OrganizationInspectionStandardPolicyVersion[]
  inspectionCriterionResults InspectionCriterionResult[]
  workers                    Worker[]
  incidents                  Incident[]
  incidentWorkers            IncidentWorker[]
  incidentInvestigations     IncidentInvestigation[]
  incidentFactors            IncidentContributingFactor[]
  incidentActions            IncidentAction[]
  incidentEvidence           IncidentEvidence[]
  ppeCatalogItems            PpeCatalogItem[]
  ppeRequirements            WorkerPpeRequirement[]
  ppeIssues                  PpeIssue[]
  ppeInspections             PpeInspection[]
}

model WorkCenter {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @db.Uuid
  name                 String
  city                 String?
  isDemo               Boolean                @default(false)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workAreas            WorkArea[]
  inspections          Inspection[]
  findings             InspectionFinding[]
  technicalAssessments TechnicalAssessment[]
  adaptiveScopes       AdaptiveSessionScope[]
  obligationExecutions ObligationExecution[]
  workPermits          WorkPermit[]
  workers              Worker[]
  incidents            Incident[]
  ppeRequirements      WorkerPpeRequirement[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Worker {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  displayName    String       @db.VarChar(200)
  internalCode   String?      @db.VarChar(80)
  status         WorkerStatus @default(ACTIVE)
  workCenterId   String?      @db.Uuid
  jobTitle       String?      @db.VarChar(200)
  linkedUserId   String?      @db.Uuid
  startDate      DateTime?    @db.Date
  endDate        DateTime?    @db.Date
  notes          String?      @db.VarChar(2000)
  createdById    String       @db.Uuid
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workCenter     WorkCenter?  @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  linkedUser     User?        @relation("WorkerLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("WorkerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  incidentLinks  IncidentWorker[]
  ppeRequirements WorkerPpeRequirement[]
  ppeIssues       PpeIssue[]

  @@unique([organizationId, internalCode])
  @@unique([organizationId, linkedUserId])
  @@index([organizationId, status, displayName])
  @@index([organizationId, workCenterId, status])
  @@index([organizationId, linkedUserId])
}

model Incident {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  workCenterId       String             @db.Uuid
  occurredAt         DateTime
  reportedAt         DateTime?
  reportedByUserId   String             @db.Uuid
  title              String             @db.VarChar(200)
  description        String             @db.VarChar(4000)
  eventType          IncidentEventType
  status             IncidentStatus     @default(DRAFT)
  activityContext    String?            @db.VarChar(1000)
  linkedInspectionId String?            @db.Uuid
  linkedFindingId    String?            @db.Uuid
  linkedAssessmentId String?            @db.Uuid
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workCenter         WorkCenter         @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  reportedBy         User               @relation("IncidentReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  linkedInspection   Inspection?        @relation(fields: [linkedInspectionId], references: [id], onDelete: Restrict)
  linkedFinding      InspectionFinding? @relation(fields: [linkedFindingId], references: [id], onDelete: Restrict)
  linkedAssessment   TechnicalAssessment? @relation(fields: [linkedAssessmentId], references: [id], onDelete: Restrict)
  involvedWorkers    IncidentWorker[]
  investigation      IncidentInvestigation?
  contributingFactors IncidentContributingFactor[]
  actions            IncidentAction[]
  evidence           IncidentEvidence[]

  @@index([organizationId, status, occurredAt])
  @@index([organizationId, workCenterId, status])
  @@index([organizationId, eventType, occurredAt])
  @@index([linkedInspectionId])
  @@index([linkedFindingId])
  @@index([linkedAssessmentId])
}

model IncidentWorker {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  incidentId     String       @db.Uuid
  workerId       String       @db.Uuid
  involvement    String?      @db.VarChar(500)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident       Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  worker         Worker       @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([incidentId, workerId])
  @@index([organizationId, workerId, createdAt])
}

model IncidentInvestigation {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @db.Uuid
  incidentId     String                      @unique @db.Uuid
  status         IncidentInvestigationStatus @default(IN_PROGRESS)
  summary        String?                     @db.VarChar(4000)
  startedById    String                      @db.Uuid
  startedAt      DateTime                    @default(now())
  completedById  String?                     @db.Uuid
  completedAt    DateTime?
  version        Int                         @default(1)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  incident       Incident                    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  startedBy      User                        @relation("IncidentInvestigationStarter", fields: [startedById], references: [id], onDelete: Restrict)
  completedBy    User?                       @relation("IncidentInvestigationCompleter", fields: [completedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, startedAt])
}

model IncidentContributingFactor {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  incidentId     String                 @db.Uuid
  category       IncidentFactorCategory
  description    String                 @db.VarChar(2000)
  rationale      String?                @db.VarChar(2000)
