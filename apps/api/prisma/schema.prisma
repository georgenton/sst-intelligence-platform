}

model InspectionFinding {
  id                      String                            @id @default(uuid()) @db.Uuid
  organizationId          String                            @db.Uuid
  inspectionId            String                            @db.Uuid
  workCenterId            String                            @db.Uuid
  workAreaId              String?                           @db.Uuid
  category                String
  title                   String
  description             String
  status                  FindingStatus                     @default(OPEN)
  riskMethodKey           String
  riskMethodVersion       String
  riskMethodVersionId     String                            @default(dbgenerated("'54000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  riskMethodSnapshot      Json                              @default("{}")
  initialMethodInput      Json                              @default("{}")
  initialMethodResult     Json                              @default("{}")
  guidanceVersionId       String?                           @db.Uuid
  guidanceSnapshot        Json?
  initialLikelihood       Int?
  initialConsequence      Int?
  initialScore            Int?
  initialRiskLevel        RiskLevel?
  initialResultLabel      String?
  residualLikelihood      Int?
  residualConsequence     Int?
  residualScore           Int?
  residualRiskLevel       RiskLevel?
  residualResultLabel     String?
  residualMethodInput     Json?
  residualMethodResult    Json?
  residualRationale       String?
  residualMethodVersionId String?                           @db.Uuid
  recurrenceCount         Int                               @default(0)
  recurrenceStatus        RecurrenceStatus                  @default(NONE)
  createdById             String                            @db.Uuid
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  closedAt                DateTime?
  criterionResultId       String?                           @unique @db.Uuid
  organization            Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection              Inspection                        @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  workCenter              WorkCenter                        @relation(fields: [workCenterId], references: [id])
  workArea                WorkArea?                         @relation(fields: [workAreaId], references: [id])
  createdBy               User                              @relation("FindingCreator", fields: [createdById], references: [id])
  riskMethodVersionRef    RiskMethodVersion                 @relation("FindingRiskMethodVersion", fields: [riskMethodVersionId], references: [id], onDelete: Restrict)
  residualMethodVersion   RiskMethodVersion?                @relation("FindingResidualMethodVersion", fields: [residualMethodVersionId], references: [id], onDelete: Restrict)
  guidanceVersion         RiskMethodExpertGuidanceVersion?  @relation(fields: [guidanceVersionId], references: [id], onDelete: Restrict)
  actions                 CorrectiveAction[]
  alerts                  InspectionAlert[]
  regulatoryLinks         InspectionFindingRegulatoryLink[]
  criterionResult         InspectionCriterionResult?        @relation(fields: [criterionResultId], references: [id], onDelete: Restrict)
  incidents               Incident[]
  ppeRequirements         WorkerPpeRequirement[]

  @@index([organizationId, inspectionId])
  @@index([organizationId, workCenterId, category, createdAt])
  @@index([organizationId, status, initialRiskLevel])
  @@index([organizationId, recurrenceStatus])
  @@index([riskMethodVersionId])
  @@index([residualMethodVersionId])
}

