  @@index([organizationId, status, dueAt])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, incidentId, status])
}

model IncidentEvidence {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  incidentId       String                @db.Uuid
  incidentActionId String?               @db.Uuid
