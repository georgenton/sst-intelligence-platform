model RegulatoryUnit {
  id                    String                              @id @default(uuid()) @db.Uuid
  sourceVersionId       String                              @db.Uuid
  parentUnitId          String?                             @db.Uuid
  unitType              RegulatoryUnitType
  identifier            String                              @db.VarChar(160)
  heading               String?                             @db.VarChar(500)
  ordinal               Int
  officialText          String
  editorialSummary      String?
  normalizedTextHash    String                              @db.VarChar(71)
  pageStart             Int?
  pageEnd               Int?
  locator               String                              @db.VarChar(240)
  extractionStatus      RegulatoryUnitExtractionStatus
  reviewStatus          RegulatoryUnitReviewStatus          @default(UNREVIEWED)
  createdAt             DateTime                            @default(now())
  sourceVersion         RegulatorySourceVersion             @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  parentUnit            RegulatoryUnit?                     @relation("RegulatoryUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: Restrict)
  childUnits            RegulatoryUnit[]                    @relation("RegulatoryUnitHierarchy")
  provisions            RegulatoryProvisionUnit[]
  interpretationReviews RegulatoryInterpretationReview[]
  unifiedItems          UnifiedSstEvaluationItem[]
  findingLinks          InspectionFindingRegulatoryLink[]
  technicalLinks        TechnicalAssessmentRegulatoryLink[]
  obligationExecutions  ObligationExecution[]

  @@unique([sourceVersionId, identifier])
  @@unique([sourceVersionId, ordinal])
  @@index([sourceVersionId, unitType, ordinal])
  @@index([normalizedTextHash])
}

model RegulatoryProvisionUnit {
  provisionId String              @db.Uuid
  unitId      String              @db.Uuid
  createdAt   DateTime            @default(now())
  provision   RegulatoryProvision @relation(fields: [provisionId], references: [id], onDelete: Restrict)
  unit        RegulatoryUnit      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@id([provisionId, unitId])
  @@index([unitId])
}

model RegulatoryRuleDraftRequirement {
  ruleDraftId      String                      @db.Uuid
  requirementId    String                      @db.Uuid
  relationshipType AdaptiveRuleRequirementType
  createdAt        DateTime                    @default(now())
  ruleDraft        AdaptiveRuleDraft           @relation(fields: [ruleDraftId], references: [id], onDelete: Restrict)
  requirement      RegulatoryRequirement       @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@id([ruleDraftId, requirementId, relationshipType])
  @@index([requirementId])
}

model RegulatoryInterpretationReview {
  id                      String                                 @id @default(uuid()) @db.Uuid
  ruleDraftId             String                                 @db.Uuid
  requirementId           String                                 @db.Uuid
  unitId                  String                                 @db.Uuid
  reviewerUserId          String                                 @db.Uuid
  decision                RegulatoryInterpretationReviewDecision
  comment                 String?                                @db.VarChar(2000)
  engineOutputHash        String                                 @db.VarChar(71)
  sourceVersionIdSnapshot String                                 @db.Uuid
  requirementSnapshot     Json
  ruleDraftSnapshot       Json
  createdAt               DateTime                               @default(now())
  ruleDraft               AdaptiveRuleDraft                      @relation(fields: [ruleDraftId], references: [id], onDelete: Restrict)
  requirement             RegulatoryRequirement                  @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  unit                    RegulatoryUnit                         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reviewer                User                                   @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([ruleDraftId, requirementId, createdAt])
  @@index([unitId, createdAt])
}

model UnifiedSstEvaluation {
  id               String                        @id @default(uuid()) @db.Uuid
  organizationId   String                        @db.Uuid
  profileVersionId String                        @db.Uuid
  status           UnifiedSstEvaluationStatus    @default(DRAFT)
  createdById      String                        @db.Uuid
  contextSnapshot  Json
  createdAt        DateTime                      @default(now())
  evaluatedAt      DateTime?
  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profileVersion   OrganizationSstProfileVersion @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  createdBy        User                          @relation("UnifiedEvaluationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items            UnifiedSstEvaluationItem[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model UnifiedSstEvaluationItem {
  id                         String                @id @default(uuid()) @db.Uuid
  evaluationId               String                @db.Uuid
  requirementId              String                @db.Uuid
  ruleDraftId                String                @db.Uuid
  unitId                     String                @db.Uuid
  proposedState              ApplicabilityState
  whyMatched                 String                @db.VarChar(1000)
  organizationFacts          Json
  predicateTrace             Json
  regulatoryTrace            Json
  currentStateSnapshot       Json?
  organizationEvidence       Json
  riskReferences             Json
  engineOutputHash           String                @db.VarChar(71)
  professionalReviewRequired Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  evaluation                 UnifiedSstEvaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  requirement                RegulatoryRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  ruleDraft                  AdaptiveRuleDraft     @relation(fields: [ruleDraftId], references: [id], onDelete: Restrict)
  unit                       RegulatoryUnit        @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, ruleDraftId])
  @@index([requirementId, unitId])
}

model InspectionFindingRegulatoryLink {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  findingId      String                       @db.Uuid
  unitId         String?                      @db.Uuid
  requirementId  String?                      @db.Uuid
  provenance     RegulatoryRiskLinkProvenance
  rationale      String                       @db.VarChar(1000)
  createdAt      DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finding        InspectionFinding            @relation(fields: [findingId], references: [id], onDelete: Cascade)
  unit           RegulatoryUnit?              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  requirement    RegulatoryRequirement?       @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@unique([findingId, unitId, requirementId, provenance])
  @@index([organizationId, findingId])
}

model TechnicalAssessmentRegulatoryLink {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  assessmentId   String                       @db.Uuid
  unitId         String?                      @db.Uuid
  requirementId  String?                      @db.Uuid
  provenance     RegulatoryRiskLinkProvenance
  rationale      String                       @db.VarChar(1000)
  createdAt      DateTime                     @default(now())
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     TechnicalAssessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  unit           RegulatoryUnit?              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  requirement    RegulatoryRequirement?       @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, unitId, requirementId, provenance])
  @@index([organizationId, assessmentId])
}

model RegulatoryRequirementSource {
  id               String                                @id @default(uuid()) @db.Uuid
  requirementId    String                                @db.Uuid
  provisionId      String                                @db.Uuid
  relationshipType RegulatoryRequirementRelationshipType
  createdAt        DateTime                              @default(now())
  requirement      RegulatoryRequirement                 @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  provision        RegulatoryProvision                   @relation(fields: [provisionId], references: [id], onDelete: Restrict)

  @@unique([requirementId, provisionId, relationshipType])
  @@index([requirementId, relationshipType])
  @@index([provisionId, relationshipType])
}

model RegulatorySourceRelationship {
  id               String                             @id @default(uuid()) @db.Uuid
  fromSourceId     String                             @db.Uuid
  toSourceId       String                             @db.Uuid
  relationshipType RegulatoryRelationshipType
  reviewStatus     RegulatoryRelationshipReviewStatus @default(PENDING_REVIEW)
  notes            String?
  createdAt        DateTime                           @default(now())
  fromSource       RegulatorySource                   @relation("RegulatoryRelationshipFrom", fields: [fromSourceId], references: [id], onDelete: Restrict)
  toSource         RegulatorySource                   @relation("RegulatoryRelationshipTo", fields: [toSourceId], references: [id], onDelete: Restrict)

  @@unique([fromSourceId, toSourceId, relationshipType])
  @@index([fromSourceId, reviewStatus])
  @@index([toSourceId, reviewStatus])
}

model AdaptiveFactDefinition {
  id           String                @id @default(uuid()) @db.Uuid
  factKey      String                @unique @db.VarChar(160)
  category     AdaptiveFactCategory
  defaultScope AdaptiveScopeKind
  createdAt    DateTime              @default(now())
  versions     AdaptiveFactVersion[]

  @@index([category, factKey])
}

model AdaptiveFactVersion {
  id                      String                      @id @default(uuid()) @db.Uuid
  factDefinitionId        String                      @db.Uuid
  version                 String                      @db.VarChar(32)
  valueType               AdaptiveFactValueType
  questionText            String                      @db.VarChar(240)
  helpText                String                      @db.VarChar(500)
  unknownAllowed          Boolean                     @default(true)
  collectionMode          AdaptiveFactCollectionMode
  validation              Json
  choiceOptions           Json
  priority                Int                         @default(100)
  publishedAt             DateTime                    @default(now())
  supersedesFactVersionId String?                     @unique @db.Uuid
  factDefinition          AdaptiveFactDefinition      @relation(fields: [factDefinitionId], references: [id], onDelete: Restrict)
  supersedesFactVersion   AdaptiveFactVersion?        @relation("AdaptiveFactVersionReplacement", fields: [supersedesFactVersionId], references: [id], onDelete: Restrict)
  supersededByFactVersion AdaptiveFactVersion?        @relation("AdaptiveFactVersionReplacement")
  packFacts               AdaptiveRulePackFact[]
  answers                 AdaptiveFactAnswer[]
  questions               AdaptiveGeneratedQuestion[]

  @@unique([factDefinitionId, version])
  @@index([factDefinitionId, publishedAt])
}

model AdaptiveConfigurationTargetDefinition {
  id        String                               @id @default(uuid()) @db.Uuid
  targetKey String                               @unique @db.VarChar(160)
  createdAt DateTime                             @default(now())
  versions  AdaptiveConfigurationTargetVersion[]
}

model AdaptiveConfigurationTargetVersion {
  id                        String                                @id @default(uuid()) @db.Uuid
  targetDefinitionId        String                                @db.Uuid
  version                   String                                @db.VarChar(32)
  title                     String                                @db.VarChar(160)
  description               String                                @db.VarChar(500)
  category                  AdaptiveTargetCategory
  currentStateQuestion      String                                @db.VarChar(240)
  evidenceSuggestions       Json
  isDemo                    Boolean                               @default(false)
  publishedAt               DateTime                              @default(now())
  supersedesTargetVersionId String?                               @unique @db.Uuid
  targetDefinition          AdaptiveConfigurationTargetDefinition @relation(fields: [targetDefinitionId], references: [id], onDelete: Restrict)
  supersedesTargetVersion   AdaptiveConfigurationTargetVersion?   @relation("AdaptiveTargetVersionReplacement", fields: [supersedesTargetVersionId], references: [id], onDelete: Restrict)
  supersededByTargetVersion AdaptiveConfigurationTargetVersion?   @relation("AdaptiveTargetVersionReplacement")
  packTargets               AdaptiveRulePackTarget[]
  items                     AdaptiveConfigurationItem[]

  @@unique([targetDefinitionId, version])
  @@index([targetDefinitionId, publishedAt])
}

model AdaptiveRuleDefinition {
  id        String                @id @default(uuid()) @db.Uuid
  ruleKey   String                @unique @db.VarChar(160)
  createdAt DateTime              @default(now())
  drafts    AdaptiveRuleDraft[]
  versions  AdaptiveRuleVersion[]
}

model AdaptiveRuleDraft {
  id                    String                           @id @default(uuid()) @db.Uuid
  ruleDefinitionId      String                           @db.Uuid
  revision              Int
  status                AdaptiveRuleDraftStatus          @default(DRAFT)
  schema                Json
  isDemo                Boolean                          @default(false)
  regulatory            Boolean                          @default(false)
  demoDisclaimer        String?                          @db.VarChar(500)
  technicalReviewedAt   DateTime?
  legalReviewedAt       DateTime?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  ruleDefinition        AdaptiveRuleDefinition           @relation(fields: [ruleDefinitionId], references: [id], onDelete: Restrict)
  publishedVersion      AdaptiveRuleVersion?             @relation("AdaptiveRuleSourceDraft")
  requirements          RegulatoryRuleDraftRequirement[]
  interpretationReviews RegulatoryInterpretationReview[]
  unifiedItems          UnifiedSstEvaluationItem[]

  @@unique([ruleDefinitionId, revision])
  @@index([status, updatedAt])
}

model AdaptiveRuleVersion {
  id                      String                    @id @default(uuid()) @db.Uuid
  ruleDefinitionId        String                    @db.Uuid
  version                 String                    @db.VarChar(32)
  schema                  Json
  isDemo                  Boolean                   @default(false)
  regulatory              Boolean                   @default(false)
  demoDisclaimer          String?                   @db.VarChar(500)
  sourceDraftId           String?                   @unique @db.Uuid
  publishedAt             DateTime?
  sealedAt                DateTime?
  supersedesRuleVersionId String?                   @unique @db.Uuid
  ruleDefinition          AdaptiveRuleDefinition    @relation(fields: [ruleDefinitionId], references: [id], onDelete: Restrict)
  sourceDraft             AdaptiveRuleDraft?        @relation("AdaptiveRuleSourceDraft", fields: [sourceDraftId], references: [id], onDelete: Restrict)
  supersedesRuleVersion   AdaptiveRuleVersion?      @relation("AdaptiveRuleVersionReplacement", fields: [supersedesRuleVersionId], references: [id], onDelete: Restrict)
  supersededByRuleVersion AdaptiveRuleVersion?      @relation("AdaptiveRuleVersionReplacement")
  requirements            AdaptiveRuleRequirement[]
  groupRules              AdaptiveRuleGroupRule[]
  packRules               AdaptiveRulePackRule[]

  @@unique([ruleDefinitionId, version])
  @@index([regulatory, isDemo, publishedAt])
}

model AdaptiveRuleRequirement {
  id               String                      @id @default(uuid()) @db.Uuid
  ruleVersionId    String                      @db.Uuid
  requirementId    String                      @db.Uuid
  relationshipType AdaptiveRuleRequirementType
  createdAt        DateTime                    @default(now())
  ruleVersion      AdaptiveRuleVersion         @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  requirement      RegulatoryRequirement       @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@unique([ruleVersionId, requirementId, relationshipType])
  @@index([requirementId, relationshipType])
}

model AdaptiveRuleGroupDefinition {
  id        String                     @id @default(uuid()) @db.Uuid
  groupKey  String                     @unique @db.VarChar(160)
  createdAt DateTime                   @default(now())
  versions  AdaptiveRuleGroupVersion[]
}

model AdaptiveRuleGroupVersion {
  id                       String                      @id @default(uuid()) @db.Uuid
  groupDefinitionId        String                      @db.Uuid
  version                  String                      @db.VarChar(32)
  title                    String                      @db.VarChar(160)
  priority                 Int
  scopeMode                String                      @db.VarChar(32)
  activationExpression     Json
  isDemo                   Boolean                     @default(false)
  regulatory               Boolean                     @default(false)
  publishedAt              DateTime?
  sealedAt                 DateTime?
  supersedesGroupVersionId String?                     @unique @db.Uuid
  groupDefinition          AdaptiveRuleGroupDefinition @relation(fields: [groupDefinitionId], references: [id], onDelete: Restrict)
  supersedesGroupVersion   AdaptiveRuleGroupVersion?   @relation("AdaptiveGroupVersionReplacement", fields: [supersedesGroupVersionId], references: [id], onDelete: Restrict)
  supersededByGroupVersion AdaptiveRuleGroupVersion?   @relation("AdaptiveGroupVersionReplacement")
  groupRules               AdaptiveRuleGroupRule[]
  packGroups               AdaptiveRulePackGroup[]

  @@unique([groupDefinitionId, version])
  @@index([priority, publishedAt])
}

model AdaptiveRuleGroupRule {
  groupVersionId String                   @db.Uuid
  ruleVersionId  String                   @db.Uuid
  sortOrder      Int
  groupVersion   AdaptiveRuleGroupVersion @relation(fields: [groupVersionId], references: [id], onDelete: Restrict)
  ruleVersion    AdaptiveRuleVersion      @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@id([groupVersionId, ruleVersionId])
  @@index([ruleVersionId])
}

model AdaptiveRulePackDefinition {
  id        String                    @id @default(uuid()) @db.Uuid
  packKey   String                    @unique @db.VarChar(160)
  name      String                    @db.VarChar(160)
  createdAt DateTime                  @default(now())
  versions  AdaptiveRulePackVersion[]
}

model AdaptiveRulePackVersion {
  id                  String                         @id @default(uuid()) @db.Uuid
  packDefinitionId    String                         @db.Uuid
  version             String                         @db.VarChar(32)
  engineSchemaVersion String                         @db.VarChar(32)
  schema              Json
  contentHash         String                         @db.VarChar(100)
  isDemo              Boolean                        @default(false)
  regulatory          Boolean                        @default(false)
  disclaimer          String                         @db.VarChar(500)
  publishedAt         DateTime?
  sealedAt            DateTime?
  packDefinition      AdaptiveRulePackDefinition     @relation(fields: [packDefinitionId], references: [id], onDelete: Restrict)
  groups              AdaptiveRulePackGroup[]
  rules               AdaptiveRulePackRule[]
  facts               AdaptiveRulePackFact[]
  targets             AdaptiveRulePackTarget[]
  sessions            AdaptiveConfigurationSession[]
  evaluationRuns      AdaptiveEvaluationRun[]

  @@unique([packDefinitionId, version])
  @@unique([packDefinitionId, contentHash])
  @@index([isDemo, regulatory, publishedAt])
}

model AdaptiveRulePackGroup {
  packVersionId  String                   @db.Uuid
  groupVersionId String                   @db.Uuid
  packVersion    AdaptiveRulePackVersion  @relation(fields: [packVersionId], references: [id], onDelete: Restrict)
  groupVersion   AdaptiveRuleGroupVersion @relation(fields: [groupVersionId], references: [id], onDelete: Restrict)

  @@id([packVersionId, groupVersionId])
  @@index([groupVersionId])
}

model AdaptiveRulePackRule {
  packVersionId String                  @db.Uuid
  ruleVersionId String                  @db.Uuid
  packVersion   AdaptiveRulePackVersion @relation(fields: [packVersionId], references: [id], onDelete: Restrict)
  ruleVersion   AdaptiveRuleVersion     @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)

  @@id([packVersionId, ruleVersionId])
  @@index([ruleVersionId])
}

model AdaptiveRulePackFact {
  packVersionId String                  @db.Uuid
  factVersionId String                  @db.Uuid
  packVersion   AdaptiveRulePackVersion @relation(fields: [packVersionId], references: [id], onDelete: Restrict)
  factVersion   AdaptiveFactVersion     @relation(fields: [factVersionId], references: [id], onDelete: Restrict)

  @@id([packVersionId, factVersionId])
  @@index([factVersionId])
}

model AdaptiveRulePackTarget {
  packVersionId   String                             @db.Uuid
  targetVersionId String                             @db.Uuid
  packVersion     AdaptiveRulePackVersion            @relation(fields: [packVersionId], references: [id], onDelete: Restrict)
  targetVersion   AdaptiveConfigurationTargetVersion @relation(fields: [targetVersionId], references: [id], onDelete: Restrict)

  @@id([packVersionId, targetVersionId])
  @@index([targetVersionId])
}

model AdaptiveConfigurationSession {
  id                String                          @id @default(uuid()) @db.Uuid
  organizationId    String                          @db.Uuid
  profileVersionId  String                          @db.Uuid
  rulePackVersionId String                          @db.Uuid
  status            AdaptiveSessionStatus           @default(COLLECTING_INFORMATION)
  sessionRevision   Int                             @default(0)
  createdById       String                          @db.Uuid
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  finalizedAt       DateTime?
  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profileVersion    OrganizationSstProfileVersion   @relation(fields: [profileVersionId], references: [id], onDelete: Restrict)
  rulePackVersion   AdaptiveRulePackVersion         @relation(fields: [rulePackVersionId], references: [id], onDelete: Restrict)
  createdBy         User                            @relation("AdaptiveSessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  scopes            AdaptiveSessionScope[]
  answers           AdaptiveFactAnswer[]
  runs              AdaptiveEvaluationRun[]
  proposals         AdaptiveConfigurationProposal[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

model AdaptiveSessionScope {
  id                  String                       @id @default(uuid()) @db.Uuid
  organizationId      String                       @db.Uuid
  sessionId           String                       @db.Uuid
  scopeKey            String                       @db.VarChar(200)
  kind                AdaptiveScopeKind
  workCenterId        String?                      @db.Uuid
  displayNameSnapshot String                       @db.VarChar(240)
  activeSnapshot      Boolean                      @default(true)
  sortOrder           Int
  createdAt           DateTime                     @default(now())
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session             AdaptiveConfigurationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  workCenter          WorkCenter?                  @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  answers             AdaptiveFactAnswer[]
  questions           AdaptiveGeneratedQuestion[]
  items               AdaptiveConfigurationItem[]

  @@unique([sessionId, scopeKey])
  @@index([organizationId, sessionId])
  @@index([workCenterId])
}

model AdaptiveFactAnswer {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @db.Uuid
  sessionId      String                       @db.Uuid
  scopeId        String                       @db.Uuid
  factVersionId  String                       @db.Uuid
  typedValue     Json
  source         AdaptiveAnswerSource
  answeredById   String                       @db.Uuid
  answeredAt     DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session        AdaptiveConfigurationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  scope          AdaptiveSessionScope         @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  factVersion    AdaptiveFactVersion          @relation(fields: [factVersionId], references: [id], onDelete: Restrict)
  answeredBy     User                         @relation("AdaptiveAnswerAuthor", fields: [answeredById], references: [id], onDelete: Restrict)

  @@unique([sessionId, scopeId, factVersionId])
  @@index([organizationId, sessionId])
}

model AdaptiveEvaluationRun {
  id              String                         @id @default(uuid()) @db.Uuid
  organizationId  String                         @db.Uuid
  sessionId       String                         @db.Uuid
  runNumber       Int
  sessionRevision Int
  engineVersion   String                         @db.VarChar(32)
  packVersionId   String                         @db.Uuid
  inputSnapshot   Json
  outputSnapshot  Json
  inputHash       String                         @db.VarChar(100)
  outputHash      String                         @db.VarChar(100)
  createdAt       DateTime                       @default(now())
  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session         AdaptiveConfigurationSession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  packVersion     AdaptiveRulePackVersion        @relation(fields: [packVersionId], references: [id], onDelete: Restrict)
  questions       AdaptiveGeneratedQuestion[]
  proposal        AdaptiveConfigurationProposal?

  @@unique([sessionId, runNumber])
  @@index([organizationId, sessionId, createdAt])
}

model AdaptiveGeneratedQuestion {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  evaluationRunId       String                @db.Uuid
  scopeId               String                @db.Uuid
  factVersionId         String                @db.Uuid
  questionText          String                @db.VarChar(240)
  helpText              String                @db.VarChar(500)
  answerChoices         Json
  whyAsked              String                @db.VarChar(500)
  relatedRuleVersions   Json
  relatedTargetVersions Json
  sortOrder             Int
  createdAt             DateTime              @default(now())
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evaluationRun         AdaptiveEvaluationRun @relation(fields: [evaluationRunId], references: [id], onDelete: Restrict)
  scope                 AdaptiveSessionScope  @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  factVersion           AdaptiveFactVersion   @relation(fields: [factVersionId], references: [id], onDelete: Restrict)

  @@unique([evaluationRunId, scopeId, factVersionId])
  @@index([organizationId, evaluationRunId, sortOrder])
}

model AdaptiveConfigurationProposal {
  id              String                       @id @default(uuid()) @db.Uuid
  organizationId  String                       @db.Uuid
  sessionId       String                       @db.Uuid
  evaluationRunId String                       @unique @db.Uuid
  proposalVersion Int
  createdAt       DateTime                     @default(now())
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session         AdaptiveConfigurationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  evaluationRun   AdaptiveEvaluationRun        @relation(fields: [evaluationRunId], references: [id], onDelete: Restrict)
  items           AdaptiveConfigurationItem[]

  @@unique([sessionId, proposalVersion])
  @@index([organizationId, sessionId, createdAt])
}

model AdaptiveConfigurationItem {
  id                    String                             @id @default(uuid()) @db.Uuid
  organizationId        String                             @db.Uuid
  proposalId            String                             @db.Uuid
  scopeId               String                             @db.Uuid
  targetVersionId       String                             @db.Uuid
  state                 ApplicabilityState
  minimumDepth          AdaptiveReviewDepth
  professionalReview    Boolean                            @default(false)
  reason                String                             @db.VarChar(500)
  ruleVersionProvenance Json
  requirementProvenance Json
  evidenceSuggestions   Json
  missingFacts          Json
  trace                 Json
  createdAt             DateTime                           @default(now())
  organization          Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  proposal              AdaptiveConfigurationProposal      @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  scope                 AdaptiveSessionScope               @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  targetVersion         AdaptiveConfigurationTargetVersion @relation(fields: [targetVersionId], references: [id], onDelete: Restrict)
  currentState          AdaptiveCurrentStateDeclaration?

  @@unique([proposalId, scopeId, targetVersionId])
  @@index([organizationId, proposalId])
}

model AdaptiveCurrentStateDeclaration {
  id             String                         @id @default(uuid()) @db.Uuid
  organizationId String                         @db.Uuid
  itemId         String                         @unique @db.Uuid
  status         AdaptiveCurrentStateStatus
  declaredById   String                         @db.Uuid
  declaredAt     DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  item           AdaptiveConfigurationItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  declaredBy     User                           @relation("AdaptiveDeclarationAuthor", fields: [declaredById], references: [id], onDelete: Restrict)
  evidence       AdaptiveCurrentStateEvidence[]

  @@index([organizationId, itemId])
}

model AdaptiveCurrentStateEvidence {
  id             String                           @id @default(uuid()) @db.Uuid
  organizationId String                           @db.Uuid
  declarationId  String                           @db.Uuid
  type           AdaptiveCurrentStateEvidenceType
  note           String?                          @db.VarChar(1000)
  externalUrl    String?                          @db.VarChar(1000)
  declaredById   String                           @db.Uuid
  declaredAt     DateTime                         @default(now())
  organization   Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  declaration    AdaptiveCurrentStateDeclaration  @relation(fields: [declarationId], references: [id], onDelete: Restrict)
  declaredBy     User                             @relation("AdaptiveEvidenceAuthor", fields: [declaredById], references: [id], onDelete: Restrict)

  @@index([organizationId, declarationId, declaredAt])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model OrganizationInvitation {
  id               String                       @id @default(uuid()) @db.Uuid
  organizationId   String                       @db.Uuid
  emailNormalized  String                       @db.VarChar(320)
  role             MembershipRole
  status           OrganizationInvitationStatus @default(PENDING)
  tokenHash        String                       @unique @db.VarChar(64)
  pendingKey       String?                      @unique @db.VarChar(400)
  expiresAt        DateTime
  invitedByUserId  String                       @db.Uuid
  acceptedByUserId String?                      @db.Uuid
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User                         @relation("OrganizationInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?                        @relation("OrganizationInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([organizationId, emailNormalized, createdAt])
}

model ModuleDefinition {
  id                  String               @id @default(uuid()) @db.Uuid
  key                 ModuleKey            @unique
  name                String
  description         String
  objective           String
  demoContent         Json
  sortOrder           Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationModules OrganizationModule[]
}

model OrganizationModule {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  moduleId       String                   @db.Uuid
  status         OrganizationModuleStatus
  source         ActivationSource
  startsAt       DateTime?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         ModuleDefinition         @relation(fields: [moduleId], references: [id])

  @@unique([organizationId, moduleId])
  @@index([organizationId, status])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  key           PlanKey        @unique
  name          String
  description   String
  sortOrder     Int
  planFeatures  PlanFeature[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FeatureDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  key           String           @unique
  description   String
  valueType     FeatureValueType
  planFeatures  PlanFeature[]
  usageCounters UsageCounter[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PlanFeature {
  id        String            @id @default(uuid()) @db.Uuid
  planId    String            @db.Uuid
  featureId String            @db.Uuid
  value     String
  plan      Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
}

model UsageCounter {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  featureId      String            @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  used           Int               @default(0)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature        FeatureDefinition @relation(fields: [featureId], references: [id])

  @@unique([organizationId, featureId, periodStart])
  @@index([organizationId])
}

model GuidedFlowDefinition {
  id        String              @id @default(uuid()) @db.Uuid
  key       String
  version   String
  schema    Json
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  sessions  GuidedFlowSession[]

  @@unique([key, version])
}

model GuidedFlowSession {
  id              String                  @id @default(uuid()) @db.Uuid
  definitionId    String                  @db.Uuid
  publicTokenHash String
  status          GuidedSessionStatus     @default(IN_PROGRESS)
  currentStep     Int                     @default(1)
  answers         Json                    @default("{}")
  expiresAt       DateTime
  claimedByUserId String?                 @db.Uuid
  organizationId  String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  completedAt     DateTime?
  definition      GuidedFlowDefinition    @relation(fields: [definitionId], references: [id])
  claimedBy       User?                   @relation("ClaimedBy", fields: [claimedByUserId], references: [id])
  organization    Organization?           @relation(fields: [organizationId], references: [id])
  recommendation  SolutionRecommendation?

  @@index([status, expiresAt])
  @@index([organizationId])
}

model SolutionRecommendation {
  id              String            @id @default(uuid()) @db.Uuid
  sessionId       String            @unique @db.Uuid
  engineVersion   String
  result          Json
  explanation     Json
  explanationMode String
  createdAt       DateTime          @default(now())
  session         GuidedFlowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UpgradeRequest {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  requestedById  String               @db.Uuid
  message        String?
  requestedPlan  PlanKey?
  status         UpgradeRequestStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User                 @relation(fields: [requestedById], references: [id])

  @@index([organizationId, status])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json
  requestId      String
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model AiInteraction {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @db.Uuid
  userId         String?             @db.Uuid
  useCase        String
  provider       String
  model          String?
  promptVersion  String
  latencyMs      Int
  inputTokens    Int?
  outputTokens   Int?
  status         AiInteractionStatus
  errorCategory  String?
  inputHash      String
  createdAt      DateTime            @default(now())
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}
