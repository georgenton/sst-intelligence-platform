  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         ModuleDefinition         @relation(fields: [moduleId], references: [id])

  @@unique([organizationId, moduleId])
  @@index([organizationId, status])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  key           PlanKey        @unique
  name          String
  description   String
  sortOrder     Int
  planFeatures  PlanFeature[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FeatureDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  key           String           @unique
  description   String
  valueType     FeatureValueType
  planFeatures  PlanFeature[]
  usageCounters UsageCounter[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PlanFeature {
  id        String            @id @default(uuid()) @db.Uuid
  planId    String            @db.Uuid
  featureId String            @db.Uuid
  value     String
  plan      Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
}

model UsageCounter {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  featureId      String            @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  used           Int               @default(0)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature        FeatureDefinition @relation(fields: [featureId], references: [id])

  @@unique([organizationId, featureId, periodStart])
  @@index([organizationId])
}

model GuidedFlowDefinition {
  id        String              @id @default(uuid()) @db.Uuid
  key       String
  version   String
  schema    Json
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  sessions  GuidedFlowSession[]

  @@unique([key, version])
}

model GuidedFlowSession {
  id              String                  @id @default(uuid()) @db.Uuid
  definitionId    String                  @db.Uuid
  publicTokenHash String
  status          GuidedSessionStatus     @default(IN_PROGRESS)
  currentStep     Int                     @default(1)
  answers         Json                    @default("{}")
  expiresAt       DateTime
  claimedByUserId String?                 @db.Uuid
  organizationId  String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  completedAt     DateTime?
  definition      GuidedFlowDefinition    @relation(fields: [definitionId], references: [id])
  claimedBy       User?                   @relation("ClaimedBy", fields: [claimedByUserId], references: [id])
  organization    Organization?           @relation(fields: [organizationId], references: [id])
  recommendation  SolutionRecommendation?

  @@index([status, expiresAt])
  @@index([organizationId])
}

model SolutionRecommendation {
  id              String            @id @default(uuid()) @db.Uuid
  sessionId       String            @unique @db.Uuid
  engineVersion   String
  result          Json
  explanation     Json
  explanationMode String
  createdAt       DateTime          @default(now())
  session         GuidedFlowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UpgradeRequest {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  requestedById  String               @db.Uuid
  message        String?
  requestedPlan  PlanKey?
  status         UpgradeRequestStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User                 @relation(fields: [requestedById], references: [id])

  @@index([organizationId, status])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json
  requestId      String
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model AiInteraction {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @db.Uuid
  userId         String?             @db.Uuid
  useCase        String
  provider       String
  model          String?
  promptVersion  String
  latencyMs      Int
  inputTokens    Int?
  outputTokens   Int?
  status         AiInteractionStatus
  errorCategory  String?
  inputHash      String
  createdAt      DateTime            @default(now())
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}
