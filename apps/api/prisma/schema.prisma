generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ORG_OWNER
  ORG_ADMIN
  SST_MANAGER
  SST_TECHNICIAN
  CONSULTANT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  DEMO
  SUSPENDED
}

enum ModuleKey {
  CORE
  INSPECTIONS_INTELLIGENCE
  TECHNICAL_RISK
  WORK_PERMITS
  PSYCHOSOCIAL
  COMPLIANCE
}

enum OrganizationModuleStatus {
  AVAILABLE
  DEMO
  TRIAL
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ActivationSource {
  PLAN
  RECOMMENDATION
  TRIAL
  MANUAL
  ENTERPRISE
}

enum PlanKey {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  SUSPENDED
  CANCELED
}

enum FeatureValueType {
  BOOLEAN
  INTEGER
  STRING
}

enum GuidedSessionStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
  DEMO_ACTIVATED
  EXPIRED
}

enum UpgradeRequestStatus {
  OPEN
  CONTACTED
  CLOSED
}

enum AiInteractionStatus {
  SUCCEEDED
  FALLBACK
  FAILED
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum FindingStatus {
  OPEN
  ACTION_IN_PROGRESS
  PENDING_VERIFICATION
  CLOSED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum RecurrenceStatus {
  NONE
  REPEATED
  SYSTEMIC_REVIEW_RECOMMENDED
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  PENDING_VERIFICATION
  COMPLETED
  CANCELED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionEvidenceType {
  NOTE
  EXTERNAL_LINK
}

enum TechnicalMethodStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum TechnicalAssessmentStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REVIEWED
  CANCELED
}

enum TechnicalEvidenceType {
  NOTE
  EXTERNAL_LINK
}

enum TechnicalReviewDecision {
  APPROVED
  NEEDS_REVISION
}

enum InspectionAlertType {
  RECURRENCE
  OVERDUE_ACTION
  HIGH_RESIDUAL_RISK
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id                           String                        @id @default(uuid()) @db.Uuid
  email                        String                        @unique
  passwordHash                 String
  displayName                  String
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  refreshSessions              RefreshSession[]
  memberships                  Membership[]
  claimedGuidedSessions        GuidedFlowSession[]           @relation("ClaimedBy")
  auditLogs                    AuditLog[]                    @relation("AuditActor")
  aiInteractions               AiInteraction[]
  upgradeRequests              UpgradeRequest[]
  inspections                  Inspection[]                  @relation("InspectionInspector")
  findingsCreated              InspectionFinding[]           @relation("FindingCreator")
  actionsAssigned              CorrectiveAction[]            @relation("ActionAssignee")
  actionsCreated               CorrectiveAction[]            @relation("ActionCreator")
  actionsVerified              CorrectiveAction[]            @relation("ActionVerifier")
  evidenceCreated              ActionEvidence[]              @relation("EvidenceCreator")
  alertsAcknowledged           InspectionAlert[]             @relation("AlertAcknowledger")
  technicalAssessments         TechnicalAssessment[]         @relation("TechnicalAssessmentCreator")
  technicalAssessmentsReviewed TechnicalAssessment[]         @relation("TechnicalAssessmentReviewer")
  technicalEvidenceCreated     TechnicalAssessmentEvidence[] @relation("TechnicalEvidenceCreator")
  technicalReviews             TechnicalAssessmentReview[]   @relation("TechnicalReviewReviewer")
}

model RefreshSession {
  id              String    @id @default(uuid()) @db.Uuid
  familyId        String    @db.Uuid
  tokenHash       String
  userId          String    @db.Uuid
  expiresAt       DateTime
  revokedAt       DateTime?
  reuseDetectedAt DateTime?
  replacedById    String?   @db.Uuid
  ip              String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
}

model Organization {
  id                         String                        @id @default(uuid()) @db.Uuid
  name                       String
  country                    String
  sector                     String?
  status                     OrganizationStatus            @default(ACTIVE)
  demoStartedAt              DateTime?
  demoExpiresAt              DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  workCenters                WorkCenter[]
  memberships                Membership[]
  invitations                OrganizationInvitation[]
  modules                    OrganizationModule[]
  subscriptions              Subscription[]
  usageCounters              UsageCounter[]
  guidedSessions             GuidedFlowSession[]
  upgradeRequests            UpgradeRequest[]
  auditLogs                  AuditLog[]
  aiInteractions             AiInteraction[]
  workAreas                  WorkArea[]
  inspections                Inspection[]
  findings                   InspectionFinding[]
  correctiveActions          CorrectiveAction[]
  actionEvidence             ActionEvidence[]
  inspectionAlerts           InspectionAlert[]
  technicalMethodDefinitions TechnicalMethodDefinition[]
  technicalMethodVersions    TechnicalMethodVersion[]
  technicalAssessments       TechnicalAssessment[]
  technicalResponses         TechnicalAssessmentResponse[]
  technicalResults           TechnicalAssessmentResult[]
  technicalEvidence          TechnicalAssessmentEvidence[]
  technicalReviews           TechnicalAssessmentReview[]
}

model WorkCenter {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @db.Uuid
  name                 String
  city                 String?
  isDemo               Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workAreas            WorkArea[]
  inspections          Inspection[]
  findings             InspectionFinding[]
  technicalAssessments TechnicalAssessment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model WorkArea {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @db.Uuid
  workCenterId         String                @db.Uuid
  name                 String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workCenter           WorkCenter            @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  inspections          Inspection[]
  findings             InspectionFinding[]
  technicalAssessments TechnicalAssessment[]

  @@unique([organizationId, workCenterId, name])
  @@index([organizationId, isActive])
  @@index([organizationId, workCenterId])
}

model Inspection {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @db.Uuid
  workCenterId    String              @db.Uuid
  workAreaId      String?             @db.Uuid
  title           String
  description     String?
  inspectorUserId String              @db.Uuid
  status          InspectionStatus    @default(DRAFT)
  startedAt       DateTime?
  completedAt     DateTime?
  scheduledFor    DateTime?
  isDemo          Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter          @relation(fields: [workCenterId], references: [id])
  workArea        WorkArea?           @relation(fields: [workAreaId], references: [id])
  inspector       User                @relation("InspectionInspector", fields: [inspectorUserId], references: [id])
  findings        InspectionFinding[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, workCenterId])
  @@index([organizationId, inspectorUserId])
}

model InspectionFinding {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  inspectionId        String             @db.Uuid
  workCenterId        String             @db.Uuid
  workAreaId          String?            @db.Uuid
  category            String
  title               String
  description         String
  status              FindingStatus      @default(OPEN)
  riskMethodKey       String
  riskMethodVersion   String
  initialLikelihood   Int
  initialConsequence  Int
  initialScore        Int
  initialRiskLevel    RiskLevel
  residualLikelihood  Int?
  residualConsequence Int?
  residualScore       Int?
  residualRiskLevel   RiskLevel?
  recurrenceCount     Int                @default(0)
  recurrenceStatus    RecurrenceStatus   @default(NONE)
  createdById         String             @db.Uuid
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  closedAt            DateTime?
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection          Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  workCenter          WorkCenter         @relation(fields: [workCenterId], references: [id])
  workArea            WorkArea?          @relation(fields: [workAreaId], references: [id])
  createdBy           User               @relation("FindingCreator", fields: [createdById], references: [id])
  actions             CorrectiveAction[]
  alerts              InspectionAlert[]

  @@index([organizationId, inspectionId])
  @@index([organizationId, workCenterId, category, createdAt])
  @@index([organizationId, status, initialRiskLevel])
  @@index([organizationId, recurrenceStatus])
}

model CorrectiveAction {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  findingId        String                 @db.Uuid
  title            String
  description      String?
  assignedToUserId String?                @db.Uuid
  status           CorrectiveActionStatus @default(OPEN)
  priority         ActionPriority         @default(MEDIUM)
  dueAt            DateTime?
  completedAt      DateTime?
  verifiedAt       DateTime?
  verifiedByUserId String?                @db.Uuid
  createdById      String                 @db.Uuid
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finding          InspectionFinding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  assignedTo       User?                  @relation("ActionAssignee", fields: [assignedToUserId], references: [id])
  verifiedBy       User?                  @relation("ActionVerifier", fields: [verifiedByUserId], references: [id])
  createdBy        User                   @relation("ActionCreator", fields: [createdById], references: [id])
  evidence         ActionEvidence[]

  @@index([organizationId, findingId])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, assignedToUserId])
}

model ActionEvidence {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  correctiveActionId String             @db.Uuid
  type               ActionEvidenceType
  note               String?
  externalUrl        String?
  createdById        String             @db.Uuid
  createdAt          DateTime           @default(now())
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  correctiveAction   CorrectiveAction   @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)
  createdBy          User               @relation("EvidenceCreator", fields: [createdById], references: [id])

  @@index([organizationId, correctiveActionId])
}

model InspectionAlert {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  findingId        String              @db.Uuid
  type             InspectionAlertType
  severity         AlertSeverity
  status           AlertStatus         @default(OPEN)
  message          String
  createdAt        DateTime            @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?             @db.Uuid
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finding          InspectionFinding   @relation(fields: [findingId], references: [id], onDelete: Cascade)
  acknowledgedBy   User?               @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id])

  @@unique([findingId, type])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, type])
}

model TechnicalMethodDefinition {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String?                  @db.Uuid
  key            String
  name           String
  description    String
  category       String
  status         TechnicalMethodStatus    @default(DRAFT)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       TechnicalMethodVersion[]

  @@unique([organizationId, key])
  @@index([key, status])
  @@index([organizationId, status])
}

model TechnicalMethodVersion {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String?                   @db.Uuid
  methodDefinitionId String                    @db.Uuid
  version            String
  schema             Json
  calculationKey     String
  regulatory         Boolean                   @default(false)
  country            String?
  validFrom          DateTime?
  validTo            DateTime?
  status             TechnicalMethodStatus     @default(DRAFT)
  createdAt          DateTime                  @default(now())
  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  methodDefinition   TechnicalMethodDefinition @relation(fields: [methodDefinitionId], references: [id], onDelete: Cascade)
  assessments        TechnicalAssessment[]

  @@unique([methodDefinitionId, version])
  @@index([organizationId, status])
  @@index([calculationKey, status])
}

model TechnicalAssessment {
  id               String                        @id @default(uuid()) @db.Uuid
  organizationId   String                        @db.Uuid
  workCenterId     String                        @db.Uuid
  workAreaId       String?                       @db.Uuid
  methodVersionId  String                        @db.Uuid
  methodKey        String
  methodVersion    String
  calculationKey   String
  methodSnapshot   Json
  title            String
  description      String?
  status           TechnicalAssessmentStatus     @default(DRAFT)
  createdById      String                        @db.Uuid
  reviewedById     String?                       @db.Uuid
  startedAt        DateTime?
  completedAt      DateTime?
  reviewedAt       DateTime?
  isDemo           Boolean                       @default(false)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workCenter       WorkCenter                    @relation(fields: [workCenterId], references: [id])
  workArea         WorkArea?                     @relation(fields: [workAreaId], references: [id])
  methodVersionRef TechnicalMethodVersion        @relation(fields: [methodVersionId], references: [id])
  createdBy        User                          @relation("TechnicalAssessmentCreator", fields: [createdById], references: [id])
  reviewedBy       User?                         @relation("TechnicalAssessmentReviewer", fields: [reviewedById], references: [id])
  responses        TechnicalAssessmentResponse[]
  result           TechnicalAssessmentResult?
  evidence         TechnicalAssessmentEvidence[]
  reviews          TechnicalAssessmentReview[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, workCenterId])
  @@index([organizationId, methodKey])
}

model TechnicalAssessmentResponse {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  assessmentId   String              @db.Uuid
  questionKey    String
  value          Json
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     TechnicalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionKey])
  @@index([organizationId, assessmentId])
}

model TechnicalAssessmentResult {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  assessmentId   String              @unique @db.Uuid
  methodKey      String
  methodVersion  String
  calculationKey String
  score          Float?
  level          RiskLevel?
  result         Json
  calculatedAt   DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     TechnicalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, level])
}

model TechnicalAssessmentEvidence {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  assessmentId   String                @db.Uuid
  questionKey    String?
  type           TechnicalEvidenceType
  note           String?
  externalUrl    String?
  createdById    String                @db.Uuid
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     TechnicalAssessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("TechnicalEvidenceCreator", fields: [createdById], references: [id])

  @@index([organizationId, assessmentId])
}

model TechnicalAssessmentReview {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  assessmentId   String                  @db.Uuid
  reviewerUserId String                  @db.Uuid
  decision       TechnicalReviewDecision
  comment        String?
  createdAt      DateTime                @default(now())
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     TechnicalAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reviewer       User                    @relation("TechnicalReviewReviewer", fields: [reviewerUserId], references: [id])

  @@index([organizationId, assessmentId, createdAt])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
}

model OrganizationInvitation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  email          String
  role           MembershipRole
  tokenHash      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, expiresAt])
}

model ModuleDefinition {
  id                  String               @id @default(uuid()) @db.Uuid
  key                 ModuleKey            @unique
  name                String
  description         String
  objective           String
  demoContent         Json
  sortOrder           Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organizationModules OrganizationModule[]
}

model OrganizationModule {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  moduleId       String                   @db.Uuid
  status         OrganizationModuleStatus
  source         ActivationSource
  startsAt       DateTime?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         ModuleDefinition         @relation(fields: [moduleId], references: [id])

  @@unique([organizationId, moduleId])
  @@index([organizationId, status])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  key           PlanKey        @unique
  name          String
  description   String
  sortOrder     Int
  planFeatures  PlanFeature[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model FeatureDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  key           String           @unique
  description   String
  valueType     FeatureValueType
  planFeatures  PlanFeature[]
  usageCounters UsageCounter[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model PlanFeature {
  id        String            @id @default(uuid()) @db.Uuid
  planId    String            @db.Uuid
  featureId String            @db.Uuid
  value     String
  plan      Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  planId         String             @db.Uuid
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
}

model UsageCounter {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  featureId      String            @db.Uuid
  periodStart    DateTime
  periodEnd      DateTime
  used           Int               @default(0)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature        FeatureDefinition @relation(fields: [featureId], references: [id])

  @@unique([organizationId, featureId, periodStart])
  @@index([organizationId])
}

model GuidedFlowDefinition {
  id        String              @id @default(uuid()) @db.Uuid
  key       String
  version   String
  schema    Json
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  sessions  GuidedFlowSession[]

  @@unique([key, version])
}

model GuidedFlowSession {
  id              String                  @id @default(uuid()) @db.Uuid
  definitionId    String                  @db.Uuid
  publicTokenHash String
  status          GuidedSessionStatus     @default(IN_PROGRESS)
  currentStep     Int                     @default(1)
  answers         Json                    @default("{}")
  expiresAt       DateTime
  claimedByUserId String?                 @db.Uuid
  organizationId  String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  completedAt     DateTime?
  definition      GuidedFlowDefinition    @relation(fields: [definitionId], references: [id])
  claimedBy       User?                   @relation("ClaimedBy", fields: [claimedByUserId], references: [id])
  organization    Organization?           @relation(fields: [organizationId], references: [id])
  recommendation  SolutionRecommendation?

  @@index([status, expiresAt])
  @@index([organizationId])
}

model SolutionRecommendation {
  id              String            @id @default(uuid()) @db.Uuid
  sessionId       String            @unique @db.Uuid
  engineVersion   String
  result          Json
  explanation     Json
  explanationMode String
  createdAt       DateTime          @default(now())
  session         GuidedFlowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UpgradeRequest {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  requestedById  String               @db.Uuid
  message        String?
  requestedPlan  PlanKey?
  status         UpgradeRequestStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User                 @relation(fields: [requestedById], references: [id])

  @@index([organizationId, status])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json
  requestId      String
  ip             String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model AiInteraction {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @db.Uuid
  userId         String?             @db.Uuid
  useCase        String
  provider       String
  model          String?
  promptVersion  String
  latencyMs      Int
  inputTokens    Int?
  outputTokens   Int?
  status         AiInteractionStatus
  errorCategory  String?
  inputHash      String
  createdAt      DateTime            @default(now())
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  user           User?               @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}
