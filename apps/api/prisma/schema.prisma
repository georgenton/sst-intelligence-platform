model Inspection {
  id                      String                                       @id @default(uuid()) @db.Uuid
  organizationId          String                                       @db.Uuid
  workCenterId            String                                       @db.Uuid
  workAreaId              String?                                      @db.Uuid
  title                   String
  description             String?
  inspectorUserId         String                                       @db.Uuid
  status                  InspectionStatus                             @default(DRAFT)
  startedAt               DateTime?
  completedAt             DateTime?
  scheduledFor            DateTime?
  isDemo                  Boolean                                      @default(false)
  createdAt               DateTime                                     @default(now())
  updatedAt               DateTime                                     @updatedAt
  organization            Organization                                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workCenter              WorkCenter                                   @relation(fields: [workCenterId], references: [id])
  workArea                WorkArea?                                    @relation(fields: [workAreaId], references: [id])
  inspector               User                                         @relation("InspectionInspector", fields: [inspectorUserId], references: [id])
  riskMethodVersionId     String                                       @default(dbgenerated("'54000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  riskMethodSnapshot      Json                                         @default("{}")
  inspectionDomain        InspectionDomain?
  standardPolicyVersionId String?                                      @db.Uuid
  standardVersionId       String?                                      @db.Uuid
  standardSnapshot        Json?
  findings                InspectionFinding[]
  criterionResults        InspectionCriterionResult[]
  riskMethodVersion       RiskMethodVersion                            @relation(fields: [riskMethodVersionId], references: [id], onDelete: Restrict)
  standardPolicyVersion   OrganizationInspectionStandardPolicyVersion? @relation(fields: [standardPolicyVersionId], references: [id], onDelete: Restrict)
  standardVersion         InspectionStandardVersion?                   @relation(fields: [standardVersionId], references: [id], onDelete: Restrict)
  incidents               Incident[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, workCenterId])
  @@index([organizationId, inspectorUserId])
  @@index([riskMethodVersionId])
  @@index([organizationId, inspectionDomain])
  @@index([standardPolicyVersionId])
  @@index([standardVersionId])
}

model InspectionCriterionResult {
  id                 String                      @id @default(uuid()) @db.Uuid
  organizationId     String                      @db.Uuid
  inspectionId       String                      @db.Uuid
