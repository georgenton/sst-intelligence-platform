model PpeIssue {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @db.Uuid
  workerId              String                   @db.Uuid
  ppeCatalogItemId      String                   @db.Uuid
  requirementId         String?                  @db.Uuid
