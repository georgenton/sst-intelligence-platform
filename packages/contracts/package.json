{
  "name": "@sst/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sst-assessment-catalog": {
      "types": "./dist/sst-assessment-catalog.d.ts",
      "require": "./dist/sst-assessment-catalog.js",
      "default": "./dist/sst-assessment-catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sst/typescript-config": "workspace:*",
    "@types/node": "24.10.13",
    "vitest": "4.1.0"
  }
}
