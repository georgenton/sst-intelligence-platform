APP_NAME="SST Inteligente"
NEXT_PUBLIC_APP_NAME="SST Inteligente"
NODE_ENV="development"
PORT="3001"
WEB_ORIGIN="http://localhost:3000"
API_ORIGIN="http://localhost:3001"
DATABASE_URL="postgresql://sst:sst@localhost:5448/sst?schema=public"
JWT_ACCESS_SECRET="development-only-change-with-at-least-32-characters"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_DAYS="30"
COOKIE_SECURE="false"
AUTH_REFRESH_COOKIE_NAME="sst_refresh"
AI_ENABLED="false"
AI_PROVIDER="template"
OPENAI_API_KEY=""
OPENAI_MODEL=""
# Explicit external-AI boundary. Keep production on deterministic local.
SST_DEPLOYMENT_ENVIRONMENT="local"
APP_ENV="local"
CONVERSATIONAL_AI_PROVIDER="DETERMINISTIC_LOCAL_V1"
CONVERSATIONAL_AI_EXTERNAL_ENABLED="false"
CONVERSATIONAL_AI_OPENAI_MODEL="gpt-5.6-terra"
CONVERSATIONAL_AI_STAGING_ORGANIZATION_IDS=""
CONVERSATIONAL_AI_STAGING_USER_IDS=""
# Staging-only synthetic bootstrap. Never configure this in production.
STAGING_BOOTSTRAP_PASSWORD=""
DEMO_DURATION_DAYS="14"
LOG_LEVEL="info"
